# ==============================================================================
# NeXooAi Virtual Saree Try-On — Environment Configuration Template
# DO NOT store real API keys or passwords in this template.
# Copy this file to .env and fill in real values for your environment.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="NeXooAi Virtual Saree Try-On"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite+aiosqlite:///./nexooai_dev.sqlite3"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://nexoo_user:your_password@localhost:5432/nexooai_db"

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./media
PUBLIC_BASE_URL="http://127.0.0.1:8000"
# In production set this to the HTTPS address customers can reach, for example:
# PUBLIC_BASE_URL="https://tryon.your-showroom.in"
# S3 / MinIO Settings (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="nexooai-tryon-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ap-south-1"

# AI Virtual Try-On Provider (mock | gemini | huggingface | fal-fashn | fal-kolors | fashn | replicate)
AI_TRYON_PROVIDER=gemini
FAL_KEY=""
GEMINI_API_KEY=""
HF_TOKEN=""
AI_TRYON_API_KEY=""
AI_TRYON_API_URL=""
AI_TRYON_TIMEOUT_SECONDS=60
AI_TRYON_MAX_RETRIES=2

# Security & Download Tokens
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
DOWNLOAD_TOKEN_EXPIRY_MINUTES=30
MEDIA_RETENTION_HOURS=24

# Kiosk Settings
KIOSK_DEFAULT_LANGUAGE=ta
KIOSK_INACTIVITY_TIMEOUT_SECONDS=90
